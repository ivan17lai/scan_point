# Station data and configuration — never commit these.
# station.json holds the admin PIN. cloud.config and key backup files hold
# remote-access credentials. The scan logs are participant data.
station.json
cloud.config
upload.key
scanpoint-keys.json
scans.jsonl
scans-*.csv
/export/

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

